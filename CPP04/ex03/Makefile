NAME := inter

CXX := c++
CXXFLAGS := -Wall -Wextra -Werror -std=c++98

SRCS_DIR := srcs
INCL_DIR := includes

CXXFLAGS += -I$(INCL_DIR)

SRCS := $(SRCS_DIR)/main.cpp
SRCS += $(SRCS_DIR)/AMateria.cpp
SRCS += $(SRCS_DIR)/Cure.cpp
SRCS += $(SRCS_DIR)/Ice.cpp
SRCS += $(SRCS_DIR)/Character.cpp
SRCS += $(SRCS_DIR)/MateriaSource.cpp

OBJS := $(SRCS:.cpp=.o)

all: $(NAME)

$(NAME): $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $^

clean:
	rm -f $(OBJS)

fclean: clean
	rm -f $(NAME)

re: fclean all

.SILENT: clean fclean
.PHONY: all clean fclean re
